# Copy to .env and replace every placeholder before enabling external integrations.
POSTGRES_DB=fmcsa_monitor
POSTGRES_USER=fmcsa_app
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://fmcsa_app:change-this-local-password@postgres:5432/fmcsa_monitor

# Secret used by n8n to call POST /run/daily. Generate a long random value.
FMCSA_RUN_TOKEN=replace-with-a-long-random-secret

# Optional Socrata app token. Public FMCSA data may work without one; set if you have one.
SOCRATA_APP_TOKEN=

# Zoho is deliberately disabled until the CRM fields/module have been created and tested.
ZOHO_SYNC_ENABLED=false
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ALERT_MODULE_API_NAME=FMCSA_Alerts
ZOHO_EVENT_KEY_FIELD_API_NAME=Event_Key
ZOHO_TASKS_ENABLED=false
ZOHO_TASK_EVENT_KEY_FIELD_API_NAME=FMCSA_Event_Key
ZOHO_TASK_DUE_DAYS=1

# Do not turn CRM sync on until the custom FMCSA_Alerts module contains the fields listed in README.md.
# Task sync is optional and requires a unique FMCSA_Event_Key custom field on Zoho CRM Tasks.
